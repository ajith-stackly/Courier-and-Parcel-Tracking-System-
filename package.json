{
  "name": "courier-parcel-tracking",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
"server": "node node_modules/json-server/lib/cli/bin.js --watch db.json --host 0.0.0.0 --port 3001" ,
    "start": "concurrently \"npm run server\" \"npm run dev\"",
    "server:win": "node node_modules\\json-server\\lib\\cli\\bin.js --watch db.json --port 3001",
    "dev:win": "node node_modules\\vite\\bin\\vite.js",
    "start:win": "concurrently \"npm run server:win\" \"npm run dev:win\""
  },
  "dependencies": {
    "axios": "^1.7.2",
    "date-fns": "^3.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.2.1",
    "react-router-dom": "^6.23.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "json-server": "^0.17.4",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "vite": "^5.2.13"
  }
}
